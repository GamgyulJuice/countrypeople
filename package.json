{
  "name": "countrypeople",
  "private": true,
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "build": "turbo run build",
    "test:e2e": "pnpm --filter @rural/web test:e2e",
    "db:generate": "pnpm --filter @rural/api db:generate",
    "db:migrate": "pnpm --filter @rural/api db:migrate",
    "db:seed": "pnpm --filter @rural/api db:seed"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/node": "26.6.4",
    "eslint": "^9.0.0",
    "turbo": "2.11.7",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.0",
    "vitest": "5.0.3"
  }
}
